# Configure privately on the host. Never paste secrets into ChatGPT or commit this file with values.
OPENAI_API_KEY=
# Choose supported models in your API account; no unverified model default is assumed.
TEXT_MODEL=
IMAGE_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# For S3-compatible storage; blank for AWS S3
S3_ENDPOINT_URL=
# Public HTTPS asset origin; only generated illustrations belong here.
IMAGE_PUBLIC_BASE_URL=
# Enable after authenticated integration test. false produces reviewable local artifacts.
PUBLISH_ENABLED=false
